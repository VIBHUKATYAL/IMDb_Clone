{
  "name": "imdb-clone-platform",
  "version": "1.0.0",
  "description": "IMDb-style movie platform with Personal Match Score and AI Mood Mode",
  "scripts": {
    "db:start": "tsx scripts/start-db.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "server": "tsx watch server/src/index.ts",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"db,server,client\" -c \"magenta,blue,green\" \"npm run db:start\" \"npm run server\" \"npm run client\"",
    "sync:tmdb": "tsx scripts/sync-tmdb.ts",
    "build:client": "npm --prefix client run build",
    "build:server": "tsc -p server/tsconfig.json"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "embedded-postgres": "^18.7.0-beta.19",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "concurrently": "^10.0.7",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
