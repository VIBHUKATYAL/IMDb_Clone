datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reviews      Review[]
  watchlist    Watchlist[]
  interactions UserMovieInteraction[]
  reviewLikes  ReviewLike[]

  @@map("users")
}

model Movie {
  id          String   @id @default(uuid())
  title       String
  description String
  posterUrl   String
  backdropUrl String?
  releaseDate DateTime
  runtime     Int
  language    String   @default("English")
  country     String   @default("United States")
  imdbRating  Float    @default(0.0)
  popularity  Float    @default(0.0)
  voteCount   Int      @default(0)
  trailerUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  genres       MovieGenre[]
  cast         MovieCast[]
  directors    MovieDirector[]
  reviews      Review[]
  watchlists   Watchlist[]
  interactions UserMovieInteraction[]

  @@map("movies")
}

model Genre {
  id     String       @id @default(uuid())
  name   String       @unique
  movies MovieGenre[]

  @@map("genres")
}

model MovieGenre {
  movieId String
  genreId String

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([movieId, genreId])
  @@map("movie_genres")
}

model CastMember {
  id        String      @id @default(uuid())
  name      String
  photoUrl  String?
  biography String?
  movies    MovieCast[]

  @@map("cast_members")
}

model MovieCast {
  movieId      String
  castMemberId String
  character    String
  castOrder    Int         @default(0)

  movie      Movie      @relation(fields: [movieId], references: [id], onDelete: Cascade)
  castMember CastMember @relation(fields: [castMemberId], references: [id], onDelete: Cascade)

  @@id([movieId, castMemberId])
  @@map("movie_casts")
}

model Director {
  id     String          @id @default(uuid())
  name   String
  movies MovieDirector[]

  @@map("directors")
}

model MovieDirector {
  movieId    String
  directorId String

  movie    Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  director Director @relation(fields: [directorId], references: [id], onDelete: Cascade)

  @@id([movieId, directorId])
  @@map("movie_directors")
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  movieId   String
  rating    Int
  title     String
  content   String
  likes     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie   Movie        @relation(fields: [movieId], references: [id], onDelete: Cascade)
  likedBy ReviewLike[]

  @@unique([userId, movieId])
  @@map("reviews")
}

model ReviewLike {
  userId    String
  reviewId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([userId, reviewId])
  @@map("review_likes")
}

model Watchlist {
  id        String   @id @default(uuid())
  userId    String
  movieId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@map("watchlists")
}

enum InteractionType {
  VIEW
  LIKE
  DISLIKE
  RATE
  WATCHLIST_ADD
  WATCHLIST_REMOVE
}

model UserMovieInteraction {
  id              String          @id @default(uuid())
  userId          String
  movieId         String
  interactionType InteractionType
  value           Float?
  createdAt       DateTime        @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([userId, interactionType])
  @@map("user_movie_interactions")
}
